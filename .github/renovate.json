{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nuxt/renovate-config-nuxt"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["mixpanel", "mixpanel-browser"],
      "groupName": null
    },
    {
      "matchPackageNames": ["docus", "@nuxt/content"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docs framework"
    },
    {
      "description": "Keep MDC serialization compatible until https://github.com/syntax-tree/mdast-util-to-markdown/pull/88 is released and validated",
      "matchPackageNames": ["mdast-util-to-markdown"],
      "allowedVersions": "2.1.2"
    }
  ]
}
